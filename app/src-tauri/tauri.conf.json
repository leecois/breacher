{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breacher",
  "version": "0.2.6",
  "identifier": "dev.breacher.mk2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Breacher",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 520,
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Breacher overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (c) 2026 The Breacher authors",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QjBGMUQzQkQ5NzdEODkKUldTSmZaZTkwL0d3NlN5ZWl5UFF3bGRUQ3RSTmtwdFdpbGRRWmV1M2hxZ1MzQlNrVEVBc3laR3EK",
      "endpoints": [
        "https://github.com/leecois/breacher/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
