{
  "name": "breacher-app",
  "private": true,
  "version": "0.4.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "wasm": "cargo build -p breach-wasm --target wasm32-unknown-unknown --release && node scripts/copy-wasm.mjs",
    "predev": "npm run wasm",
    "dev": "vite",
    "prebuild": "npm run wasm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
